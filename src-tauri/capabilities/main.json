{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capabilities of the TruongSync main desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "shell:allow-open",
    "autostart:default",
    "allow-get-bootstrap-info",
    "allow-check-tools",
    "allow-get-settings",
    "allow-save-settings",
    "allow-set-os-native-auto-launch",
    "allow-list-volumes",
    "allow-eject-volume-cmd",
    "allow-list-year-categories",
    "allow-create-category-folder",
    "allow-list-import-presets",
    "allow-save-import-preset",
    "allow-delete-import-preset",
    "allow-scan-card",
    "allow-preflight-import",
    "allow-preview-import-plan",
    "allow-run-import-pipeline",
    "allow-cancel-active-job",
    "allow-cancel-oauth",
    "allow-find-matching-gpx",
    "allow-preview-geotag",
    "allow-run-geotag",
    "allow-list-cloud-profiles",
    "allow-save-cloud-profile",
    "allow-delete-cloud-profile",
    "allow-import-rclone-conf",
    "allow-list-rclone-remotes-cmd",
    "allow-connect-google-drive",
    "allow-verify-cloud-cmd",
    "allow-sync-cloud-cmd",
    "allow-list-external-profiles",
    "allow-save-external-profile",
    "allow-delete-external-profile",
    "allow-verify-external-cmd",
    "allow-sync-external-cmd",
    "allow-list-jobs",
    "allow-list-job-items",
    "allow-show-main-window-cmd",
    "allow-quit-app-cmd",
    "allow-check-update-feed",
    "allow-install-native-update"
  ]
}
